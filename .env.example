# URL of your deployed Cloudflare Worker (no trailing slash).
# Required only for the Share Records feature.
# Example: https://rewardtrackr.<your-subdomain>.workers.dev
VITE_WORKER_URL=

# CryptoCompare API key (fallback for CoinGecko 401 on data older than ~1 year)
# Get a free key at https://www.cryptocompare.com/cryptopian/api-keys
VITE_CRYPTOCOMPARE_API_KEY=
