# All variables are optional and end up in the client bundle: never put secrets here.

# URL of your deployed Cloudflare Worker (no trailing slash).
# Needed for Share, the export rate limit, announcements, stats and price history.
# Example: https://rewardtrackr.<your-subdomain>.workers.dev
VITE_WORKER_URL=

# GoMining API base URLs. Defaults to the public GoMining hosts (or same-origin
# Worker paths on rewardtrackr.com). For local dev use the Vite proxy: /gomining-api
VITE_API_BASE=
VITE_API_SE_BASE=
VITE_BONUS_MINER_API_BASE=

# CryptoCompare base URL (the API key is a Worker secret: CRYPTOCOMPARE_API_KEY).
VITE_CRYPTOCOMPARE_API_BASE=

# Sentry DSN for production error reporting.
VITE_SENTRY_DSN=
